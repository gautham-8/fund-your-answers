# Copy to .env and fill in.

# Local MongoDB, or your Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=viva

# Any long random string. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names (change without touching code)
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_VIVA_MODEL=gemini-3.5-flash-lite
GEMINI_SCORING_MODEL=gemini-3.5-flash-lite

UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173

# Tried in order when the main model is overloaded or times out
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_SECONDS=60
